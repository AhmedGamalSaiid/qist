{
  "name": "incoming-sheet-data-foundation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Recovered financial model from the household spreadsheet, restated as tested TypeScript over Cloudflare D1.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "tsx scripts/migrate-local.ts",
    "db:migrate:wrangler": "wrangler d1 migrations apply incoming-sheet-local --local",
    "import": "tsx scripts/import.ts",
    "reconcile": "tsx scripts/reconcile.ts",
    "claim": "tsx scripts/claim.ts",
    "goldens:generate": "tsx scripts/goldens.ts",
    "coverage:generate": "tsx scripts/coverage.ts",
    "coverage:check": "tsx scripts/coverage-check.ts",
    "lint:money": "tsx scripts/lint-money.ts",
    "test": "vitest run",
    "test:golden": "node scripts/vitest-runner.mjs tests/golden",
    "test:unit": "node scripts/vitest-runner.mjs tests/unit",
    "test:isolation": "node scripts/vitest-runner.mjs tests/isolation",
    "test:atomicity": "node scripts/vitest-runner.mjs tests/atomicity",
    "test:auth": "node scripts/vitest-runner.mjs tests/auth",
    "test:contract": "node scripts/vitest-runner.mjs tests/contract",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@opennextjs/cloudflare": "^1.20.4",
    "better-auth": "^1.7.2",
    "decimal.js": "^10.4.3",
    "drizzle-orm": "^0.36.4",
    "next": "^16.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "better-sqlite3": "^11.5.0",
    "drizzle-kit": "^0.28.1",
    "miniflare": "^4.20250612.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "@better-auth/core": "1.7.2"
  }
}
