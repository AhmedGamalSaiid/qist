# Required for `npm install`/`npm ci` to succeed against the current
# dependency graph, for two unrelated reasons that both need it:
#
# 1. better-auth declares an optional peer on @sveltejs/kit (a framework
#    integration this project never uses) whose own peer chain conflicts
#    with nothing we use either — a plain npm 7+ install refuses outright
#    (ERESOLVE) without --force or --legacy-peer-deps.
# 2. @opennextjs/cloudflare's dependency chain (@dotenvx/dotenvx -> eciesjs
#    -> @ecies/ciphers) needs @noble/ciphers@^1.x, while better-auth needs
#    @noble/ciphers@^2.x — a genuine version conflict two different
#    sub-dependencies must resolve independently. `--legacy-peer-deps`
#    alone was tried first and produces an incorrectly-deduped, broken
#    install here (@ecies/ciphers silently gets the incompatible v2 instead
#    of its own nested v1 copy); `force=true` uses npm's modern resolver,
#    which nests the two versions correctly.
#
# Revisit if a future better-auth/eciesjs release aligns their @noble/ciphers
# ranges — this may no longer be necessary.
force=true
